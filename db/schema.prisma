// =============================================================================
// PRISMA SCHEMA — SPO (Sistema Pimenta Ousada)
// Database Agent | MVP-004 + DT-004 + DT-005 + DT-007 + PROD-007 + DT-010 | 2026-05-29
// Versão: 2.4
// =============================================================================
//
// Stack: Next.js 14+ + Prisma ORM + SQLite (MVP) → PostgreSQL (v2/cloud)
// Para migrar para PostgreSQL: alterar provider = "postgresql" e DATABASE_URL.
//
// HISTÓRICO:
//   v2.0 (MVP-004): Removidos User, Supplier, UserRole. Adicionados CardMachine, Settings.
//                   Sale com subtotalCents, discountCents, cardMachineId, feeCents.
//   v2.1 (DT-004):  Adicionados @map em todos os campos camelCase.
//   v2.2 (DT-005):  Enums convertidos para String — SQLite não suporta enum no Prisma 5.x.
//   v2.3 (DT-007):  DateTime→String com dbgenerated (fix bug epoch ms Prisma 5+SQLite).
//                   PROD-007: adicionado costCents Int? em Product.
//   v2.4 (DT-010):  Settings ganhou address? e phone? (COM-006).
//                   CardMachineInstallment: nova tabela para taxas de parcelamento (MAQU-003/VEND-007).
//                   Sale ganhou installments (default 1) e installmentFeeBasisPoints? (VEND-007).
//
// CONVENÇÕES:
//   - Preços SEMPRE em centavos (Int) — nunca Float/Decimal para dinheiro
//   - Taxas em basis points (Int): 199 = 1,99% — nunca Float para percentual
//   - IDs via cuid() — string, opaco, URL-safe
//   - Timestamps: String com ISO 8601 (INSERT: dbgenerated strftime | UPDATE: trigger SQL)
//   - Soft delete em Product: deletedAt String? (null = ativo)
//   - Campos de cancelamento em Sale: cancelledAt String? (null = não cancelada)
//   - Todos os foreign keys têm @@index explícito (SQLite não cria automaticamente)
//   - Campos de "enum" são String — validação dos valores ocorre na API (camada de aplicação)
//   - size e color em ProductVariation podem ser "" — obrigatoriedade validada na API (DT-008)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =============================================================================
// CATALOG — Categorias, Produtos e Variações
// =============================================================================

model Category {
  id        String  @id @default(cuid())
  name      String  @unique
  isActive  Boolean @default(true) @map("is_active")
  createdAt String  @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")
  updatedAt String  @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("updated_at")

  products Product[]

  @@map("categories")
}

// Product = produto-base (ex: "Blusa Floral")
// As variações (tamanho + cor) vivem em ProductVariation com estoque próprio.
model Product {
  id         String  @id @default(cuid())
  name       String
  categoryId String  @map("category_id")
  priceCents Int     @map("price_cents") // centavos — ex: R$ 59,90 → 5990
  costCents  Int?    @map("cost_cents")  // preço de custo em centavos (PROD-007) — para cálculo de margem
  isActive   Boolean @default(true) @map("is_active")
  deletedAt  String? @map("deleted_at") // soft delete: null = ativo
  createdAt  String  @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")
  updatedAt  String  @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("updated_at")

  category   Category          @relation(fields: [categoryId], references: [id])
  variations ProductVariation[]

  @@index([categoryId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("products")
}

// ProductVariation = cada combinação única de (tamanho + cor) de um produto.
// RN-001.3: variações distintas são registros de estoque INDEPENDENTES.
// DT-008: size e color podem ser string vazia "" para produtos sem variação relevante.
model ProductVariation {
  id            String  @id @default(cuid())
  productId     String  @map("product_id")
  sku           String  @unique
  size          String  // DT-008: pode ser "" — obrigatoriedade validada na API, não no banco
  color         String  // DT-008: pode ser "" — obrigatoriedade validada na API, não no banco
  stockQuantity Int     @default(0) @map("stock_quantity") // >= 0 enforçado por trigger
  minStock      Int     @default(2) @map("min_stock")
  isActive      Boolean @default(true) @map("is_active")
  createdAt     String  @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")
  updatedAt     String  @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("updated_at")

  product      Product         @relation(fields: [productId], references: [id])
  saleItems    SaleItem[]
  stockEntries StockEntry[]
  movements    StockMovement[]

  @@unique([productId, size, color])
  @@index([productId])
  @@index([sku])
  @@index([isActive])
  @@index([stockQuantity])
  @@map("product_variations")
}

// =============================================================================
// STOCK — Entradas de estoque
// =============================================================================

model StockEntry {
  id            String  @id @default(cuid())
  variationId   String  @map("variation_id")
  quantity      Int     // > 0 — validar na API
  unitCostCents Int?    @map("unit_cost_cents") // opcional, controle interno
  notes         String?
  receivedAt    String  @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("received_at")
  createdAt     String  @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")
  updatedAt     String  @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("updated_at")

  variation ProductVariation @relation(fields: [variationId], references: [id])
  movement  StockMovement?

  @@index([variationId])
  @@index([receivedAt])
  @@map("stock_entries")
}

// =============================================================================
// SALES — Vendas, itens, maquininhas e parcelamento
// =============================================================================

// CardMachine = maquininha de cartão cadastrada pela dona (RN-010).
// feeBasisPoints = taxa à vista (1×) em basis points: 199 = 1,99%.
// Para taxas por número de parcelas, ver CardMachineInstallment.
model CardMachine {
  id             String  @id @default(cuid())
  name           String
  feeBasisPoints Int     @map("fee_basis_points") // taxa à vista (1×) — ex: 199 = 1,99%
  isActive       Boolean @default(true) @map("is_active")
  createdAt      String  @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")
  updatedAt      String  @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("updated_at")

  sales        Sale[]
  installments CardMachineInstallment[]

  @@index([isActive])
  @@map("card_machines")
}

// CardMachineInstallment = taxas por número de parcelas de uma maquininha (MAQU-003/VEND-007).
// Cada registro representa uma faixa de parcelamento (2x, 3x... 12x) com sua taxa específica.
// A taxa à vista (1×) usa o campo feeBasisPoints do CardMachine pai.
model CardMachineInstallment {
  id             String  @id @default(cuid())
  cardMachineId  String  @map("card_machine_id")
  installments   Int     // número de parcelas: 2, 3, 4... 12
  feeBasisPoints Int     @map("fee_basis_points") // taxa para essa qtd de parcelas (basis points)
  isActive       Boolean @default(true) @map("is_active")
  createdAt      String  @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")
  updatedAt      String  @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("updated_at")

  cardMachine CardMachine @relation(fields: [cardMachineId], references: [id])

  @@unique([cardMachineId, installments]) // uma taxa por nº de parcelas por maquininha
  @@index([cardMachineId])
  @@index([isActive])
  @@map("card_machine_installments")
}

// Settings = configurações globais (singleton — 1 único registro).
// PIN protege relatórios e configurações (RN-007).
// address e phone são exibidos na comanda (COM-006) — opcionais.
model Settings {
  id        String  @id @default(cuid())
  pinHash   String? @map("pin_hash")   // bcrypt hash — null = sem PIN configurado
  shopName  String  @default("Pimenta Ousada") @map("shop_name")
  address   String? @map("address")   // endereço da loja — exibido na comanda (opcional)
  phone     String? @map("phone")     // telefone da loja — exibido na comanda (opcional)
  updatedAt String  @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("updated_at")

  @@map("settings")
}

// Sale = cabeçalho da venda.
// status:        'ACTIVE' | 'CANCELLED'
// paymentMethod: 'CASH' | 'PIX' | 'DEBIT' | 'CREDIT'
// installments:  número de parcelas (1 = à vista)
model Sale {
  id                        String  @id @default(cuid())
  status                    String  @default("ACTIVE") @map("status")
  // Valores válidos: 'ACTIVE' | 'CANCELLED'
  paymentMethod             String  @map("payment_method")
  // Valores válidos: 'CASH' | 'PIX' | 'DEBIT' | 'CREDIT'
  subtotalCents             Int     @map("subtotal_cents")               // soma dos itens SEM desconto
  discountCents             Int     @default(0) @map("discount_cents")   // 0 = sem desconto
  totalCents                Int     @map("total_cents")                  // = subtotalCents - discountCents
  cardMachineId             String? @map("card_machine_id")              // null para CASH e PIX
  feeCents                  Int?    @map("fee_cents")                    // taxa estimada — informativo
  installments              Int     @default(1) @map("installments")     // parcelas: 1 = à vista (VEND-007)
  installmentFeeBasisPoints Int?    @map("installment_fee_basis_points") // taxa usada (null se à vista)
  notes                     String?
  cancelledAt               String? @map("cancelled_at")                 // null = não cancelada
  cancelReason              String? @map("cancel_reason")
  createdAt                 String  @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")
  updatedAt                 String  @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("updated_at")

  cardMachine CardMachine?    @relation(fields: [cardMachineId], references: [id])
  items       SaleItem[]
  movements   StockMovement[]

  @@index([status])
  @@index([createdAt])
  @@index([paymentMethod])
  @@index([cardMachineId])
  @@map("sales")
}

// SaleItem = linha da venda — snapshot imutável de preço.
// RN-004.3: unitPriceCents NUNCA é atualizado após criação.
model SaleItem {
  id             String @id @default(cuid())
  saleId         String @map("sale_id")
  variationId    String @map("variation_id")
  quantity       Int
  unitPriceCents Int    @map("unit_price_cents") // snapshot — imutável
  subtotalCents  Int    @map("subtotal_cents")   // = quantity × unitPriceCents
  createdAt      String @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")
  // Sem updatedAt — imutável após criação

  sale      Sale             @relation(fields: [saleId], references: [id])
  variation ProductVariation @relation(fields: [variationId], references: [id])

  @@index([saleId])
  @@index([variationId])
  @@map("sale_items")
}

// =============================================================================
// AUDIT — Movimentação de estoque
// =============================================================================

// StockMovement = log imutável de toda alteração em stockQuantity.
// type: 'ENTRY' | 'SALE' | 'CANCELLATION' | 'LOSS' | 'ADJUSTMENT'
model StockMovement {
  id           String  @id @default(cuid())
  variationId  String  @map("variation_id")
  saleId       String? @map("sale_id")
  stockEntryId String? @unique @map("stock_entry_id")
  type         String  @map("type")
  // Valores válidos: 'ENTRY' | 'SALE' | 'CANCELLATION' | 'LOSS' | 'ADJUSTMENT'
  quantity     Int     // positivo = entrada | negativo = saída
  balanceAfter Int     @map("balance_after") // snapshot de stockQuantity pós-movimento
  notes        String?
  createdAt    String  @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")
  // Sem updatedAt — imutável após criação

  variation  ProductVariation @relation(fields: [variationId], references: [id])
  sale       Sale?            @relation(fields: [saleId], references: [id])
  stockEntry StockEntry?      @relation(fields: [stockEntryId], references: [id])

  @@index([variationId])
  @@index([saleId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}
