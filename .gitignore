# =============================================================================
# .gitignore — SPO Sistema Pimenta Ousada
# =============================================================================

# Dependências
node_modules/
.pnp
.pnp.js

# Next.js build
.next/
out/
build/

# Variáveis de ambiente (NUNCA commitar)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Banco de dados SQLite (dados locais)
*.db
*.db-journal
*.db-wal
*.db-shm

# Backups automaticos — ficam apenas na maquina local, nunca no repositorio
backups/

# GitOps (GITOPS-005) — estado local da maquina, nunca no repositorio
deploy/updater.lock
deploy/channel
deploy/*.new
docker-compose.yml.bak

# Prisma
prisma/migrations/dev/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Editor
.DS_Store
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db
desktop.ini

# TypeScript
*.tsbuildinfo
next-env.d.ts
