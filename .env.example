# =============================================================================
# SPO — Sistema Pimenta Ousada
# Variáveis de Ambiente — EXEMPLO (commitar este arquivo)
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commitar o arquivo .env
# =============================================================================

# Banco de dados SQLite local (desenvolvimento)
DATABASE_URL="file:./dev.db"

# Em produção, aponte para um arquivo FORA da pasta do projeto
# (assim o banco não é sobrescrito por um git pull / atualização).
# DATABASE_URL="file:C:/SPO/dados/spo.db"

# Segredo usado pelo iron-session para assinar o cookie de sessão (PIN).
# Mínimo 32 caracteres. DEFINA UM VALOR PRÓPRIO EM PRODUÇÃO.
# Gerar com: openssl rand -base64 32
#
# QA-082: o valor abaixo é um placeholder CURTO de propósito — se você copiar
# este arquivo sem trocá-lo, o sistema recusa iniciar em produção (em vez de
# rodar com um segredo público que permitiria forjar a sessão do PIN).
# No Docker isto não é usado: o docker-entrypoint.sh gera um segredo por instalação.
SESSION_SECRET="TROQUE-ESTE-VALOR"

# PIN de acesso de 4 dígitos. Se não definido, o padrão é 1234.
# O PIN também pode ser alterado pela tela de Configurações do sistema.
APP_PIN="1234"

# Ambiente de execução: "development" ou "production".
# Em "production" o cookie de sessão é marcado como seguro (HTTPS).
NODE_ENV="development"

# GITOPS-003: versão da imagem que o docker-compose deve rodar.
# Nas máquinas da loja esta linha é GERENCIADA PELO spo-updater — não editar
# manualmente (exceto rollback manual, ver docs/d_runbook.md).
# Formatos aceitos: "v1.1.0" ou "v1.1.0@sha256:..." (pin por digest).
SPO_VERSION="v1.1.0"
