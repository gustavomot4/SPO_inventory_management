# =============================================================================
# SPO — Sistema Pimenta Ousada
# Variáveis de Ambiente — EXEMPLO (commitar este arquivo)
# Copie este arquivo para .env e preencha com os valores reais
# NUNCA commitar o arquivo .env
#
# ATENÇÃO: em produção (Docker) estas variáveis são configuradas no
# docker-compose.yml — este arquivo é apenas para desenvolvimento local.
# =============================================================================

# Banco de dados SQLite local (desenvolvimento)
DATABASE_URL="file:./prisma/dev.db"

# Segredo da sessão iron-session — mínimo 32 caracteres
# Gerar com: openssl rand -base64 32
# Em produção (Docker) configurado no docker-compose.yml
SESSION_SECRET="substitua-por-um-segredo-de-32-chars-minimo!!"

# PIN padrão de acesso (usado apenas se o PIN não foi configurado via interface)
APP_PIN="1234"

# Ambiente de execução
NODE_ENV="development"
