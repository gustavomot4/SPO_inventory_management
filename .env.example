# =============================================================================
# SPO — Sistema Pimenta Ousada
# Variáveis de Ambiente — EXEMPLO (commitar este arquivo)
# Copie este arquivo para .env e preencha com os valores reais
# NUNCA commitar o arquivo .env
# =============================================================================

# Banco de dados SQLite local (desenvolvimento)
DATABASE_URL="file:./dev.db"

# Em produção (arquivo fora da pasta do projeto para não ser sobrescrito por git pull)
# DATABASE_URL="file:C:/SPO/dados/spo.db"

# Segredo para geração de tokens de sessão
# Gerar com: openssl rand -base64 32
NEXTAUTH_SECRET="gerar-com-openssl-rand-base64-32"

# URL base da aplicação
NEXTAUTH_URL="http://localhost:3000"

# Ambiente de execução
NODE_ENV="development"
