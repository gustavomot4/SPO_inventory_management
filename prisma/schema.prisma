// =============================================================================
// PRISMA SCHEMA — SPO (Sistema Pimenta Ousada)
// Database Agent | MVP-004 + DT-004 fix | 2026-05-22
// Versão: 2.1 — Adicionados @map para alinhar camelCase com colunas snake_case
// =============================================================================
//
// Stack: Next.js 14+ + Prisma ORM + SQLite (MVP) → PostgreSQL (v2/cloud)
// Para migrar para PostgreSQL: alterar provider = "postgresql" e DATABASE_URL.
// Nenhuma linha de lógica de negócio muda — só a connection string.
//
// MUDANÇAS v2.1 (DT-004):
//   - Adicionado @map em TODOS os campos cujo nome camelCase difere do snake_case da coluna
//   - A migration SQL não mudou — apenas o schema foi corrigido
//
// CONVENÇÕES:
//   - Preços SEMPRE em centavos (Int) — nunca Float/Decimal para dinheiro
//   - Taxas em basis points (Int): 199 = 1,99% — nunca Float para percentual
//   - IDs via cuid() — string, opaco, URL-safe
//   - Timestamps: createdAt (default now) + updatedAt (@updatedAt automático)
//   - Soft delete em Product: campo deletedAt (null = ativo)
//   - Todos os foreign keys têm @@index explícito (SQLite não cria automaticamente)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum SaleStatus {
  ACTIVE
  CANCELLED
}

enum PaymentMethod {
  CASH
  PIX
  DEBIT
  CREDIT
}

enum MovementType {
  ENTRY
  SALE
  CANCELLATION
  LOSS
  ADJUSTMENT
}

// =============================================================================
// CATALOG
// =============================================================================

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id         String    @id @default(cuid())
  name       String
  categoryId String    @map("category_id")
  priceCents Int       @map("price_cents")
  isActive   Boolean   @default(true) @map("is_active")
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  category   Category          @relation(fields: [categoryId], references: [id])
  variations ProductVariation[]

  @@index([categoryId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("products")
}

model ProductVariation {
  id            String   @id @default(cuid())
  productId     String   @map("product_id")
  sku           String   @unique
  size          String
  color         String
  stockQuantity Int      @default(0) @map("stock_quantity")
  minStock      Int      @default(2) @map("min_stock")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product      Product         @relation(fields: [productId], references: [id])
  saleItems    SaleItem[]
  stockEntries StockEntry[]
  movements    StockMovement[]

  @@unique([productId, size, color])
  @@index([productId])
  @@index([sku])
  @@index([isActive])
  @@index([stockQuantity])
  @@map("product_variations")
}

// =============================================================================
// STOCK
// =============================================================================

model StockEntry {
  id            String   @id @default(cuid())
  variationId   String   @map("variation_id")
  quantity      Int
  unitCostCents Int?     @map("unit_cost_cents")
  notes         String?
  receivedAt    DateTime @default(now()) @map("received_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  variation ProductVariation @relation(fields: [variationId], references: [id])
  movement  StockMovement?

  @@index([variationId])
  @@index([receivedAt])
  @@map("stock_entries")
}

// =============================================================================
// SALES
// =============================================================================

model CardMachine {
  id             String   @id @default(cuid())
  name           String
  feeBasisPoints Int      @map("fee_basis_points")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  sales Sale[]

  @@index([isActive])
  @@map("card_machines")
}

model Settings {
  id        String   @id @default(cuid())
  pinHash   String?  @map("pin_hash")
  shopName  String   @default("Pimenta Ousada") @map("shop_name")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Sale {
  id            String        @id @default(cuid())
  status        SaleStatus    @default(ACTIVE)
  paymentMethod PaymentMethod @map("payment_method")
  subtotalCents Int           @map("subtotal_cents")
  discountCents Int           @default(0) @map("discount_cents")
  totalCents    Int           @map("total_cents")
  cardMachineId String?       @map("card_machine_id")
  feeCents      Int?          @map("fee_cents")
  notes         String?
  cancelledAt   DateTime?     @map("cancelled_at")
  cancelReason  String?       @map("cancel_reason")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  cardMachine CardMachine?    @relation(fields: [cardMachineId], references: [id])
  items       SaleItem[]
  movements   StockMovement[]

  @@index([status])
  @@index([createdAt])
  @@index([paymentMethod])
  @@index([cardMachineId])
  @@map("sales")
}

model SaleItem {
  id             String   @id @default(cuid())
  saleId         String   @map("sale_id")
  variationId    String   @map("variation_id")
  quantity       Int
  unitPriceCents Int      @map("unit_price_cents")
  subtotalCents  Int      @map("subtotal_cents")
  createdAt      DateTime @default(now()) @map("created_at")

  sale      Sale             @relation(fields: [saleId], references: [id])
  variation ProductVariation @relation(fields: [variationId], references: [id])

  @@index([saleId])
  @@index([variationId])
  @@map("sale_items")
}

// =============================================================================
// AUDIT
// =============================================================================

model StockMovement {
  id           String       @id @default(cuid())
  variationId  String       @map("variation_id")
  saleId       String?      @map("sale_id")
  stockEntryId String?      @unique @map("stock_entry_id")
  type         MovementType
  quantity     Int
  balanceAfter Int          @map("balance_after")
  notes        String?
  createdAt    DateTime     @default(now()) @map("created_at")

  variation  ProductVariation @relation(fields: [variationId], references: [id])
  sale       Sale?            @relation(fields: [saleId], references: [id])
  stockEntry StockEntry?      @relation(fields: [stockEntryId], references: [id])

  @@index([variationId])
  @@index([saleId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}
