// =============================================================================
// PRISMA SCHEMA — SPO (Sistema Pimenta Ousada)
// Database Agent | MVP-004 + DT-004 + DT-005 | 2026-05-27
// Versão: 2.2 — Enums convertidos para String (SQLite + Prisma 5.x não suporta enum)
// =============================================================================
//
// Stack: Next.js 14+ + Prisma ORM + SQLite (MVP) → PostgreSQL (v2/cloud)
// Para migrar para PostgreSQL: alterar provider = "postgresql" e DATABASE_URL.
// Ao migrar, os campos String de enum podem ser convertidos para enum real no Postgres.
//
// HISTÓRICO:
//   v2.0 (MVP-004): Removidos User, Supplier, UserRole. Adicionados CardMachine, Settings.
//                   Sale com subtotalCents, discountCents, cardMachineId, feeCents.
//   v2.1 (DT-004):  Adicionados @map em todos os campos camelCase.
//   v2.2 (DT-005):  Enums convertidos para String — SQLite não suporta enum no Prisma 5.x.
//                   Valores válidos documentados em comentário em cada campo.
//
// CONVENÇÕES:
//   - Preços SEMPRE em centavos (Int) — nunca Float/Decimal para dinheiro
//   - Taxas em basis points (Int): 199 = 1,99% — nunca Float para percentual
//   - IDs via cuid() — string, opaco, URL-safe
//   - Timestamps: createdAt (default now) + updatedAt (@updatedAt automático)
//   - Soft delete em Product: campo deletedAt (null = ativo)
//   - Todos os foreign keys têm @@index explícito (SQLite não cria automaticamente)
//   - Campos de "enum" são String — validação dos valores ocorre na API (camada de aplicação)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =============================================================================
// CATALOG — Categorias, Produtos e Variações
// =============================================================================

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

// Product = produto-base (ex: "Blusa Floral")
// As variações (tamanho + cor) vivem em ProductVariation com estoque próprio.
model Product {
  id         String    @id @default(cuid())
  name       String
  categoryId String    @map("category_id")
  priceCents Int       @map("price_cents") // centavos — ex: R$ 59,90 → 5990
  isActive   Boolean   @default(true) @map("is_active")
  deletedAt  DateTime? @map("deleted_at")  // soft delete: null = ativo
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  category   Category          @relation(fields: [categoryId], references: [id])
  variations ProductVariation[]

  @@index([categoryId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("products")
}

// ProductVariation = cada combinação única de (tamanho + cor) de um produto.
// RN-001.3: variações distintas são registros de estoque INDEPENDENTES.
model ProductVariation {
  id            String   @id @default(cuid())
  productId     String   @map("product_id")
  sku           String   @unique
  size          String
  color         String
  stockQuantity Int      @default(0) @map("stock_quantity") // >= 0 enforçado por trigger
  minStock      Int      @default(2) @map("min_stock")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product      Product         @relation(fields: [productId], references: [id])
  saleItems    SaleItem[]
  stockEntries StockEntry[]
  movements    StockMovement[]

  @@unique([productId, size, color])
  @@index([productId])
  @@index([sku])
  @@index([isActive])
  @@index([stockQuantity])
  @@map("product_variations")
}

// =============================================================================
// STOCK — Entradas de estoque
// =============================================================================

model StockEntry {
  id            String   @id @default(cuid())
  variationId   String   @map("variation_id")
  quantity      Int      // > 0 — validar na API
  unitCostCents Int?     @map("unit_cost_cents") // opcional, controle interno
  notes         String?
  receivedAt    DateTime @default(now()) @map("received_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  variation ProductVariation @relation(fields: [variationId], references: [id])
  movement  StockMovement?

  @@index([variationId])
  @@index([receivedAt])
  @@map("stock_entries")
}

// =============================================================================
// SALES — Vendas, itens e maquininhas
// =============================================================================

// CardMachine = maquininha de cartão cadastrada pela dona (RN-010).
// Taxa em basis points: 199 = 1,99%.
model CardMachine {
  id             String   @id @default(cuid())
  name           String
  feeBasisPoints Int      @map("fee_basis_points") // ex: 199 = 1,99%
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  sales Sale[]

  @@index([isActive])
  @@map("card_machines")
}

// Settings = configurações globais (singleton — 1 único registro).
// PIN protege relatórios e configurações (RN-007).
model Settings {
  id        String   @id @default(cuid())
  pinHash   String?  @map("pin_hash")   // bcrypt hash — null = sem PIN configurado
  shopName  String   @default("Pimenta Ousada") @map("shop_name")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// Sale = cabeçalho da venda.
// status:        'ACTIVE' | 'CANCELLED'
// paymentMethod: 'CASH' | 'PIX' | 'DEBIT' | 'CREDIT'
model Sale {
  id            String    @id @default(cuid())
  status        String    @default("ACTIVE") @map("status")
  // Valores válidos: 'ACTIVE' | 'CANCELLED'
  paymentMethod String    @map("payment_method")
  // Valores válidos: 'CASH' | 'PIX' | 'DEBIT' | 'CREDIT'
  subtotalCents Int       @map("subtotal_cents")  // soma dos itens SEM desconto
  discountCents Int       @default(0) @map("discount_cents") // 0 = sem desconto
  totalCents    Int       @map("total_cents")     // = subtotalCents - discountCents
  cardMachineId String?   @map("card_machine_id") // null para CASH e PIX
  feeCents      Int?      @map("fee_cents")       // taxa estimada — informativo
  notes         String?
  cancelledAt   DateTime? @map("cancelled_at")
  cancelReason  String?   @map("cancel_reason")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  cardMachine CardMachine?    @relation(fields: [cardMachineId], references: [id])
  items       SaleItem[]
  movements   StockMovement[]

  @@index([status])
  @@index([createdAt])
  @@index([paymentMethod])
  @@index([cardMachineId])
  @@map("sales")
}

// SaleItem = linha da venda — snapshot imutável de preço.
// RN-004.3: unitPriceCents NUNCA é atualizado após criação.
model SaleItem {
  id             String   @id @default(cuid())
  saleId         String   @map("sale_id")
  variationId    String   @map("variation_id")
  quantity       Int
  unitPriceCents Int      @map("unit_price_cents") // snapshot — imutável
  subtotalCents  Int      @map("subtotal_cents")   // = quantity × unitPriceCents
  createdAt      DateTime @default(now()) @map("created_at")
  // Sem updatedAt — imutável após criação

  sale      Sale             @relation(fields: [saleId], references: [id])
  variation ProductVariation @relation(fields: [variationId], references: [id])

  @@index([saleId])
  @@index([variationId])
  @@map("sale_items")
}

// =============================================================================
// AUDIT — Movimentação de estoque
// =============================================================================

// StockMovement = log imutável de toda alteração em stockQuantity.
// type: 'ENTRY' | 'SALE' | 'CANCELLATION' | 'LOSS' | 'ADJUSTMENT'
model StockMovement {
  id           String    @id @default(cuid())
  variationId  String    @map("variation_id")
  saleId       String?   @map("sale_id")
  stockEntryId String?   @unique @map("stock_entry_id")
  type         String    @map("type")
  // Valores válidos: 'ENTRY' | 'SALE' | 'CANCELLATION' | 'LOSS' | 'ADJUSTMENT'
  quantity     Int       // positivo = entrada | negativo = saída
  balanceAfter Int       @map("balance_after") // snapshot de stockQuantity pós-movimento
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  // Sem updatedAt — imutável após criação

  variation  ProductVariation @relation(fields: [variationId], references: [id])
  sale       Sale?            @relation(fields: [saleId], references: [id])
  stockEntry StockEntry?      @relation(fields: [stockEntryId], references: [id])

  @@index([variationId])
  @@index([saleId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}
